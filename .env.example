# Copy to .env (git ignores it) and fill in. Nothing in here is committed.

# Host port for the console.
PORT=8095

# Host address to listen on. 0.0.0.0 is every interface: the server itself still refuses any client outside
# ALLOWED_CIDRS, so the page stays home-network and tailnet only as long as your router doesn't forward this port.
# Set a single address (your LAN IP) to listen there alone.
BIND_IP=0.0.0.0

# Folder holding one subfolder of builds per app, named after the app's id in config/apps.json
# (for example <BUILDS_ROOT>/my-app/my-app-1.2.0-arm64.apk). Mounted read-only.
BUILDS_ROOT=/path/to/app-builds

# Container user. The default, "node", is unprivileged. Some NAS exports over NFS (Synology, for one) refuse every
# non-root uid that comes from a container; if the page says it can't read the builds folder, set 0 here. The
# container still has no capabilities, a read-only filesystem and read-only mounts.
# CONTAINER_USER=0

# Who may connect, as comma-separated CIDRs. The default covers private LAN ranges, Docker's bridge, loopback and
# Tailscale (100.64.0.0/10 and fd7a:115c:a1e0::/48). Uncomment to narrow it.
# ALLOWED_CIDRS=192.168.1.0/24,100.64.0.0/10,127.0.0.0/8,::1/128

# Time zone for times in alert emails, like America/Denver.
TZ=UTC

# This console's address, for links in alert emails (optional).
# CONSOLE_URL=http://192.168.1.50:8095

# Health checks (listed per app in config/apps.json): how often, and how many failures in a row before an alert.
CHECK_INTERVAL_SECONDS=120
CHECK_FAIL_THRESHOLD=2

# Alert email through Cloudflare Email Sending. Leave ALERT_EMAIL_TO empty to only log alerts.
# ALERT_EMAIL_FROM must be on a domain onboarded to Email Sending. The API token (Email Sending permission) goes in
# secrets/cloudflare-email-token, never in this file.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
CLOUDFLARE_ACCOUNT_ID=

# Reviews. How often to fetch them, and which new ones to email: all, low (1-2 stars) or off.
# The first fetch from each store only fills the history, so turning this on doesn't email every old review.
REVIEW_SYNC_MINUTES=60
REVIEW_EMAILS=all

# App Store Connect team API key (role: Customer Support). The .p8 file goes in secrets/app-store-connect.p8.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
# Google Play: the service account's JSON key goes in secrets/google-play-service-account.json. Nothing to set here.
