# Copy to .env (git ignores it) and fill in. Nothing in here is committed.

# Host port for the console.
PORT=8095

# Host address to listen on. 0.0.0.0 is every interface: the server itself still refuses any client outside
# ALLOWED_CIDRS, so the page stays home-network and tailnet only as long as your router doesn't forward this port.
# Set a single address (your LAN IP) to listen there alone.
BIND_IP=0.0.0.0

# Folder holding one subfolder of builds per app, named after the app's id in config/apps.json
# (for example <BUILDS_ROOT>/my-app/my-app-1.2.0-arm64.apk). Mounted read-only.
BUILDS_ROOT=/path/to/app-builds

# Container user. The default, "node", is unprivileged. Some NAS exports over NFS (Synology, for one) refuse every
# non-root uid that comes from a container; if the page says it can't read the builds folder, set 0 here. The
# container still has no capabilities, a read-only filesystem and read-only mounts.
# CONTAINER_USER=0

# Who may connect, as comma-separated CIDRs. The default covers private LAN ranges, Docker's bridge, loopback and
# Tailscale (100.64.0.0/10 and fd7a:115c:a1e0::/48). Uncomment to narrow it.
# ALLOWED_CIDRS=192.168.1.0/24,100.64.0.0/10,127.0.0.0/8,::1/128
